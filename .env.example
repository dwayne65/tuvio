APP_NAME=TUVIO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ticketflow
DB_USERNAME=ticketflow
DB_PASSWORD=ticketflow

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): send session cookies over HTTPS only
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_BACKUP_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments — use 'fake' in local/dev; 'flutterwave' or 'paytota' with the keys below in production
PAYMENT_PROVIDER=fake
TICKETFLOW_DEMO_MODE=true
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET=
PAYTOTA_BRAND_ID=
PAYTOTA_API_KEY=
PAYTOTA_PUBLIC_KEY=
PAYTOTA_BASE_URL=https://gate.paytota.com/api/v1/
PAYTOTA_MOBILE_MONEY=true
PAYTOTA_WEBHOOK_PUBLIC_KEY=
# Organizer payouts: 'manual' (admin pays and records) or 'paytota' (Mobile Money disbursement API)
PAYOUT_DRIVER=manual

# SMS tickets: "log" (writes to the log) or "africastalking"
SMS_DRIVER=log
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

USSD_PUBLIC_KEY=

# Platform
TICKETFLOW_CURRENCY=UGX
TICKETFLOW_COMMISSION_BPS=500
